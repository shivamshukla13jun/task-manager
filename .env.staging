# Node Environment
NODE_ENV=staging

# Server
PORT=3001
BASE_URL=https://api-staging.yourdomain.com

# Database
MONGO_URI=mongodb://localhost:27017/ecommerce_staging

# JWT
JWT_SECRET=staging-super-secret-jwt-key-change-this
REFRESH_TOKEN_SECRET=staging-super-secret-refresh-key-change-this
JWT_EXPIRE=1h

# Frontend
FRONTEND_URL=https://staging.yourdomain.com

# Security
BCRYPT_ROUNDS=12



# File upload
UPLOAD_BASE_DIR=uploads
UPLOAD_MAX_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,image/svg+xml,application/pdf,text/plain

# Storage provider: local | s3 | cloudinary | firebase
STORAGE_PROVIDER=local

# AWS S3
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_PUBLIC_URL=


# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=uploads

# Firebase Storage
FIREBASE_STORAGE_BUCKET=

# Twilio
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# CORS (comma-separated origins)
CORS_ORIGIN=https://staging.yourdomain.com
CORS_CREDENTIALS=true

# Logging
LOG_LEVEL=info
LOG_FILE=logs/combined.log

# Hybrid payload encryption (RSA-OAEP + AES-256-GCM).
# Requests with header `isencrypted: true` are decrypted; responses
# returned as { iv, data }. Keypair auto-generated at the paths below.
ENCRYPTION_ENABLED=true
ENCRYPTION_PRIVATE_KEY_PATH=keys/private.pem
ENCRYPTION_PUBLIC_KEY_PATH=keys/public.pem
ENCRYPTION_MAX_AGE_MS=300000

# Auto-generated Swagger docs at /api-docs
SWAGGER_ENABLED=true
SWAGGER_TITLE=E-commerce API

# Seed default data on server boot
SEED_ON_BOOT=false
